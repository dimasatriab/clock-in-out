PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
NODE_ENV=production
TZ=Asia/Jakarta

# 0 saat mencoba lewat http://localhost. Set 1 jika sudah lewat HTTPS.
COOKIE_SECURE=0
# Set 1 hanya kalau aplikasi berada di belakang Caddy.
TRUST_PROXY=0

# Semakin kecil, semakin ketat. Nilai umum face-api.js sekitar 0.4–0.6.
FACE_MATCH_MAX_DISTANCE=0.5
# Tolak GPS yang lebih buruk dari angka ini (meter). Naikkan jika toko di dalam gedung.
MAX_GPS_ACCURACY_METERS=100

# Dipakai hanya saat basis data masih kosong. Ganti sebelum dipakai sungguhan.
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=demo-admin-123

# Dipakai profil docker compose https
DOMAIN=absen.example.com
